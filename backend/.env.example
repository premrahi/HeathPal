PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/healthpal
NODE_ENV=development
# Set to 1 only when running behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Development: verification and reset codes print in the API terminal.
MAIL_MODE=console
# Production: set MAIL_MODE=smtp, HTTPS CLIENT_URL, and your SMTP details.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HealthPal <noreply@example.com>
# Optional: without a key, uploading/viewing reports still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
